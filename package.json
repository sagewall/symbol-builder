{
  "name": "symbol-builder",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --execArgv=--experimental-vm-modules",
    "test:e2e": "playwright test",
    "check:catalogs": "node scripts/check-style-catalogs.mjs",
    "dev": "astro dev",
    "dev:stop": "astro dev stop",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@arcgis/core": "~5.2.0",
    "@arcgis/map-components": "~5.2.0",
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/react": "^7.1.1",
    "@esri/calcite-components": "~5.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "allowScripts": {
    "@vaadin/vaadin-usage-statistics@2.1.3": true,
    "fsevents": true,
    "esbuild": true,
    "workerd": true
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
